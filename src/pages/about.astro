---
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About 3J Pictures',
  url: 'https://makartzfilms.com/about',
  mainEntity: {
    '@type': 'Organization',
    name: '3J Pictures',
    url: 'https://makartzfilms.com',
    foundingDate: '2024',
    slogan: 'Stories That Stay With You.',
    description: 'An independent film studio founded in 2024 and headquartered in Central Florida, building original worlds through unforgettable, emotionally driven storytelling across multiple genres.',
  },
};
---

<BaseLayout
  title="About"
  description="3J Pictures is an independent film studio in Central Florida, building original stories through unforgettable, emotionally driven filmmaking across multiple genres."
  schema={aboutPageSchema}
  darkNav={true}
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content reveal">
        <p class="eyebrow">Our Story</p>
        <h1 class="display">Stories That<br /><em>Stay</em> With You</h1>
      </div>
    </div>
  </section>

  <!-- OUR MISSION -->
  <section class="mission-section section-container">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Why We Make Them</p>
        <h2 class="heading-1" style="color: var(--text-dark);">Our Mission</h2>
      </div>
      <div class="mission-body reveal">
        <p class="body-large mission-body__lead">
          3J Pictures exists to create unforgettable stories that entertain first and endure long after the credits roll. We believe the best films don't simply ask audiences to watch, they invite them to feel, question, wonder, and leave changed.
        </p>
        <p class="body">
          As an independent studio, we develop original stories from the ground up, guiding them from the earliest spark of an idea through production and into the hands of audiences around the world. Whether mystery, suspense, horror, science fiction, or drama, our stories share one purpose: to reveal something deeply human.
        </p>
        <p class="body">
          Founded in 2024 and headquartered in Central Florida, we build original intellectual property designed to endure, across film, television, publishing, and beyond. We're building a library of stories that can resonate for generations.
        </p>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="philosophy-section section-container" style="background: var(--ink2);">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">How We Work</p>
        <h2 class="heading-1" style="color: var(--text-primary);">Our Approach</h2>
      </div>
      <div class="philosophy-grid">
        <div class="philosophy-card reveal">
          <h3 class="heading-3 philosophy-card__heading">Original Stories</h3>
          <p class="body philosophy-card__text">
            We build every project from the ground up as original intellectual property. From the first spark of an idea to the finished film, the story is ours to shape, never an acquisition, always an original.
          </p>
        </div>
        <div class="philosophy-card reveal">
          <h3 class="heading-3 philosophy-card__heading">Genre Without Limits</h3>
          <p class="body philosophy-card__text">
            Mystery, suspense, horror, science fiction, drama. We follow each story wherever it leads, united by one focus: to entertain first and reveal something deeply human.
          </p>
        </div>
        <div class="philosophy-card reveal">
          <h3 class="heading-3 philosophy-card__heading">Built to Endure</h3>
          <p class="body philosophy-card__text">
            Every film is designed to grow, across television, publishing, and future franchises, into a library of stories worth returning to for generations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="pullquote-section section-container" style="background: var(--ink2);">
    <div class="container">
      <blockquote class="pullquote reveal">
        <p class="display pullquote__text">
          "Stories have the power to change the way we see ourselves, each other, and the world. That's why we make them."
        </p>
        <cite class="eyebrow pullquote__cite">Jacob Schwartz, Founder</cite>
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section section-container">
    <div class="container cta-inner">
      <div class="reveal">
        <div class="cta-rule" aria-hidden="true"></div>
        <p class="eyebrow cta-eyebrow">What's Next</p>
        <h2 class="heading-1 cta-heading">
          Explore the work.<br />Or bring us yours.
        </h2>
        <div class="cta-buttons">
          <a href="/films" class="btn btn--primary">View Our Films</a>
          <a href="/submit" class="btn btn--ghost">Submit a Project</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  .section-header { margin-bottom: var(--space-8); }
  .section-header .eyebrow { margin-bottom: var(--space-1); }

  /* ── Hero ── */
  .page-hero {
    background: var(--ink);
    padding: var(--space-24) 0 var(--space-12);
  }
  .page-hero__content {
    max-width: 800px;
  }
  .page-hero__content .display {
    color: var(--cream);
    margin: var(--space-2) 0;
  }
  .page-hero__content em {
    font-style: italic;
    color: var(--sienna);
  }

  /* ── Origin ── */
  .origin-section {
    background: var(--parchment2);
  }
  .origin-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .origin-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  .origin-rule {
    width: 48px;
    height: 2px;
    background: var(--sienna);
    margin-bottom: var(--space-3);
  }
  .origin-blockquote__text {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-dark);
  }
  .origin-blockquote__cite {
    margin-top: var(--space-3);
    display: block;
    color: var(--sienna);
  }
  .origin-body .body-large {
    color: var(--text-dark-body);
    margin-bottom: var(--space-3);
  }
  .origin-body .body {
    color: var(--text-dark-body);
    margin-bottom: var(--space-3);
  }
  .origin-body__slogan {
    color: var(--sienna);
    margin-bottom: var(--space-3);
  }

  /* ── Mission ── */
  .mission-section {
    background: #ffffff;
  }
  .mission-body {
    max-width: 820px;
  }
  .mission-body__lead {
    color: var(--text-dark);
    margin-bottom: var(--space-4);
  }
  .mission-body .body {
    color: var(--text-dark-body);
    margin-bottom: var(--space-3);
  }

  /* ── Philosophy ── */
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 900px) {
    .philosophy-grid { grid-template-columns: 1fr; }
  }
  .philosophy-card {
    padding: var(--space-6);
    border: 1px solid var(--border-dark);
    background: var(--ink);
  }
  .philosophy-card__heading {
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .philosophy-card__text {
    color: var(--muted);
  }

  /* ── Stats ── */
  .stats-strip {
    background: var(--parchment2);
    border-top: 2px solid var(--sienna);
    border-bottom: 1px solid var(--border-light);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    text-align: center;
  }
  @media (max-width: 700px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  .stat__number {
    font-size: clamp(3rem, 7vw, 5.5rem);
    letter-spacing: -0.02em;
    color: var(--sienna);
  }

  /* ── Pull Quote ── */
  .pullquote {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .pullquote__text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.15;
    color: var(--text-primary);
  }
  .pullquote__cite {
    display: block;
    margin-top: var(--space-5);
    color: var(--sienna);
    font-style: normal;
  }

  /* ── Behind the Scenes ── */
  .bts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 900px) {
    .bts-grid { grid-template-columns: 1fr; }
  }
  .bts-card { margin: 0; }
  .bts-card__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  .bts-card .caption {
    margin-top: var(--space-2);
    color: var(--text-dark-body);
  }

  /* ── CTA ── */
  .cta-section {
    background: var(--ink2);
  }
  .cta-inner {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }
  .cta-rule {
    width: 48px;
    height: 2px;
    background: var(--sienna);
    margin: 0 auto var(--space-4);
  }
  .cta-eyebrow { margin-bottom: var(--space-2); }
  .cta-heading {
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }
  .cta-buttons {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
