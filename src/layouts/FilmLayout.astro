---
import BaseLayout from './BaseLayout.astro';
import { movieSchema } from '../lib/schema';

interface Props {
  title: string;
  director: string;
  year: number;
  genre: string[];
  tagline?: string;
  releaseDate?: string;
  logline?: string;
  description: string;
  posterImage: string;
  heroImage?: string;
  slug: string;
  imdbUrl?: string;
  trailerUrl?: string;
  streamingLinks?: { label: string; url: string }[];
  runtime?: string;
  cast?: { name: string; character?: string }[];
  crew?: { role: string; name: string }[];
  comingSoon?: boolean;
  festivalHistory?: string[];
}

const {
  title,
  director,
  year,
  genre,
  tagline,
  releaseDate,
  logline,
  description,
  posterImage,
  heroImage,
  slug,
  imdbUrl,
  trailerUrl,
  streamingLinks,
  runtime,
  cast,
  crew,
  comingSoon,
  festivalHistory,
} = Astro.props;

const writer = crew?.find((c) => /writer/i.test(c.role))?.name;
const producer = crew?.find((c) => /producer/i.test(c.role))?.name;
const yearLine = comingSoon
  ? 'Coming Soon'
  : [String(year), runtime].filter(Boolean).join(' · ');
const releaseValue = comingSoon ? 'Coming Soon' : (releaseDate ?? String(year));
const ytId = trailerUrl?.match(/[?&]v=([^&]+)/)?.[1] ?? trailerUrl?.match(/youtu\.be\/([^?&]+)/)?.[1];
const heroStill = heroImage ?? posterImage;

const schema = movieSchema({
  title,
  director,
  year,
  genre,
  description,
  posterImage,
  slug,
  imdbUrl,
  streamingLinks,
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage={posterImage}
  ogType="video.movie"
  schema={schema}
  darkNav={true}
>
  <article class="film-article">
    <!-- HERO: still fills the space above the fold; play button starts the trailer in place -->
    <section class={`film-hero${ytId ? ' film-hero--playable' : ''}`} data-yt={ytId ?? ''}>
      <div class="film-hero__media">
        <img
          class="poster-img"
          src={heroStill}
          alt={`${title} still`}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="film-hero__scrim" aria-hidden="true"></div>
      {ytId && (
        <button class="poster-play" type="button" aria-label={`Play the ${title} trailer`}>
          <span class="poster-play__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span class="poster-play__label">Watch Trailer</span>
        </button>
      )}
      <div class="film-hero__bar">
        <span class="film-hero__cat">{genre.join(' · ')}</span>
        <h1 class="film-hero__title">{title}</h1>
        <span class="film-hero__year">{yearLine}</span>
      </div>
    </section>

    <!-- DETAILS below the fold -->
    <div class="film-details">
      <div class="film-details__inner">
        {tagline && <p class="film-tagline">{tagline}</p>}
        <p class="body-large film-description">{logline ?? description}</p>

        {streamingLinks && streamingLinks.length > 0 && (
          <div class="film-watch">
            {streamingLinks.map((link) => (
              <a
                href={link.url}
                class="watch-btn watch-btn--ghost"
                target="_blank"
                rel="noopener noreferrer"
              >Watch on {link.label}</a>
            ))}
          </div>
        )}

        <dl class="film-credits">
          {cast && cast.length > 0 && (
            <div class="credit">
              <dt class="credit-label">Starring</dt>
              <dd class="credit-value">
                <ul class="cast-list" role="list">
                  {cast.map((member) => (
                    <li class="cast-item">
                      <span class="cast-name">{member.name}</span>
                      {member.character && <span class="cast-character">{member.character}</span>}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          <div class="credit">
            <dt class="credit-label">Directed by</dt>
            <dd class="credit-value">{director}</dd>
          </div>
          {writer && (
            <div class="credit">
              <dt class="credit-label">Written by</dt>
              <dd class="credit-value">{writer}</dd>
            </div>
          )}
          {producer && (
            <div class="credit">
              <dt class="credit-label">Produced by</dt>
              <dd class="credit-value">{producer}</dd>
            </div>
          )}
          <div class="credit">
            <dt class="credit-label">Release</dt>
            <dd class="credit-value">{releaseValue}</dd>
          </div>
        </dl>

        {festivalHistory && festivalHistory.length > 0 && (
          <div class="film-festivals">
            <p class="eyebrow" style="margin-bottom: var(--space-2);">Festival History</p>
            <ul class="festival-list" role="list">
              {festivalHistory.map((entry) => (
                <li class="caption festival-item">{entry}</li>
              ))}
            </ul>
          </div>
        )}

        {imdbUrl && (
          <a
            href={imdbUrl}
            class="imdb-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} on IMDb`}
          >View on IMDb</a>
        )}

        <div class="film-body prose">
          <slot />
        </div>
      </div>
    </div>
  </article>

  {ytId && (
    <div class="trailer-modal" id="trailer-modal" role="dialog" aria-modal="true" aria-label={`${title} trailer`} hidden>
      <div class="trailer-modal__backdrop" data-close></div>
      <div class="trailer-modal__dialog">
        <button type="button" class="trailer-modal__close" data-close aria-label="Close trailer">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="trailer-modal__frame" id="trailer-frame"></div>
      </div>
    </div>
  )}

  <script>
    const hero = document.querySelector<HTMLElement>('.film-hero[data-yt]');
    const ytId = hero?.dataset.yt;
    const modal = document.getElementById('trailer-modal');
    const frame = document.getElementById('trailer-frame');
    const closeBtn = modal?.querySelector<HTMLButtonElement>('.trailer-modal__close');
    if (hero && ytId && modal && frame) {
      const openTrailer = () => {
        if (frame.querySelector('iframe')) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
        iframe.title = 'Trailer';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
        frame.appendChild(iframe);
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      };
      const closeTrailer = () => {
        frame.replaceChildren();
        modal.hidden = true;
        document.body.style.overflow = '';
      };
      hero.addEventListener('click', openTrailer);
      modal.querySelectorAll('[data-close]').forEach((el) =>
        el.addEventListener('click', closeTrailer)
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeTrailer();
      });
    }
  </script>
</BaseLayout>

<style>
.film-article {
  padding: 0;
}

/* ── HERO: full-bleed still fills the space above the fold ── */
.film-hero {
  position: relative;
  height: 86svh;
  min-height: 460px;
  background: #0a0a0a;
  overflow: hidden;
}
.film-hero--playable {
  cursor: pointer;
}

.film-hero__media {
  position: absolute;
  inset: 0;
}
.poster-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Scrim: darkens edges for nav + bottom-bar legibility */
.film-hero__scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0) 22%),
    linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 30%);
  transition: opacity var(--duration-fast);
}
.film-hero--playable:hover .film-hero__scrim {
  background:
    linear-gradient(to bottom, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.15) 100%),
    linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 30%);
}

/* Play button: outline circle + triangle + label (Monkeypaw style) */
.poster-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  padding: 0;
  border: none;
  background: transparent;
  color: #fff;
  cursor: pointer;
  z-index: 2;
}
.poster-play__icon {
  width: 84px;
  height: 84px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  transition: transform var(--duration-fast), background var(--duration-fast), border-color var(--duration-fast);
}
.poster-play__icon svg {
  width: 30px;
  height: 30px;
  fill: #fff;
  margin-left: 2px;
}
.poster-play__label {
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
}
.poster-play:hover .poster-play__icon {
  transform: scale(1.08);
  background: var(--red);
  border-color: var(--red);
}

/* Trailer modal: overlays everything (incl. fixed nav) so YouTube controls work */
.trailer-modal {
  position: fixed;
  inset: 0;
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
}
.trailer-modal[hidden] {
  display: none;
}
.trailer-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.92);
  cursor: pointer;
}
.trailer-modal__dialog {
  position: relative;
  z-index: 1;
  /* Fit within both 94vw and 82vh while keeping 16:9 (82vh * 16/9 ≈ 145vh) */
  width: min(94vw, 145vh, 1200px);
}
.trailer-modal__frame {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #000;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
}
.trailer-modal__close {
  position: absolute;
  top: -46px;
  right: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  background: transparent;
  color: #fff;
  cursor: pointer;
  transition: color var(--duration-fast) var(--ease-cinematic);
}
.trailer-modal__close:hover {
  color: var(--sienna);
}
@media (max-width: 600px) {
  .trailer-modal__close {
    top: -42px;
  }
}

/* Bottom meta bar: genre | title | year */
.film-hero__bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-6) var(--space-8);
  pointer-events: none;
}
.film-hero__cat {
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--red);
}
.film-hero__title {
  margin: 0;
  text-align: center;
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2.4rem);
  color: #fff;
  letter-spacing: 0.02em;
}
.film-hero__year {
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.75);
  text-align: right;
}

/* ── DETAILS below the fold ── */
.film-details {
  max-width: 820px;
  margin: 0 auto;
  padding: var(--space-16) var(--space-6);
}

.film-description {
  color: var(--cream);
}

/* Credits — Monkeypaw-style labeled blocks */
.film-credits {
  margin: 0 0 var(--space-6);
  border-top: 1px solid var(--border);
}

.credit {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--border);
}

.credit-label {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--muted);
  padding-top: 0.15rem;
}

.credit-value {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  color: var(--cream);
  line-height: 1.4;
}

.film-watch {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-bottom: var(--space-6);
}

.watch-btn {
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  background: var(--red);
  text-decoration: none;
  padding: 0.7rem 1.4rem;
  transition: opacity var(--duration-fast);
}

.watch-btn:hover {
  opacity: 0.85;
}

.watch-btn--ghost {
  background: transparent;
  color: var(--cream);
  border: 1px solid var(--border);
}
.watch-btn--ghost:hover {
  opacity: 1;
  border-color: var(--red);
}

.film-tagline {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 1.15rem;
  color: var(--sienna);
  margin-bottom: var(--space-3);
}

/* Cast list with character names */
.cast-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.cast-item {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 var(--space-2);
}
.cast-name {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  color: var(--cream);
}
.cast-character {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--muted);
}

.film-festivals {
  margin-bottom: var(--space-6);
}

.festival-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.festival-item::before {
  content: '— ';
  color: var(--red);
}

.imdb-link {
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.imdb-link:hover { color: var(--cream); }

.film-body {
  max-width: 72ch;
}

@media (max-width: 800px) {
  .film-hero__media {
    height: min(62vh, 560px);
  }
  .film-hero__bar {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    gap: var(--space-1);
    padding: var(--space-4);
  }
  .film-hero__year {
    text-align: center;
  }
  .credit {
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }
}
</style>
