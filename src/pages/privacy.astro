---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for 3J Pictures."
  noindex={true}
  darkNav={true}
>
  <section class="legal-page">
    <div class="legal-inner">
      <p class="eyebrow legal-eyebrow">3J Pictures</p>
      <h1 class="display legal-title">Privacy Policy</h1>
      <p class="body-large legal-note">
        Our full privacy policy is on the way. In the meantime, if you have any
        questions about how we handle your information, email us at
        <a href="mailto:3jpictures@gmail.com" class="legal-link">3jpictures@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: calc(var(--space-16) + var(--space-8)) var(--space-6) var(--space-16);
  }
  .legal-inner {
    max-width: 640px;
    margin: 0 auto;
    width: 100%;
  }
  .legal-eyebrow {
    margin-bottom: var(--space-3);
  }
  .legal-title {
    color: var(--text-primary);
    margin-bottom: var(--space-5);
  }
  .legal-note {
    color: var(--text-body);
  }
  .legal-link {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--sienna);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .legal-link:hover {
    color: var(--text-primary);
  }
</style>
